      ],
      "id": "0c462349-1972-473d-a6fc-746208e504dc",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.content?.parts?.[0]?.text ?? '';\n\nconst original = $('Code in JavaScript').item.json.receivedData ?? {};\nconst originalError = original.execution?.error ?? original.error ?? {};\n\nconst errorText = [\n  originalError.message,\n  originalError.description,\n  originalError.stack,\n].filter(Boolean).join(' ');\n\nfunction getFallbackAnalysis() {\n  const text = errorText.toLowerCase();\n\n  if (/(etimedout|timeout|econnreset|temporary network|503|service unavailable|network)/i.test(text)) {\n    return {\n      category: 'transient_network',\n      retryable: true,\n      severity: 'medium',\n      diagnosis: 'Fallback rule detected a temporary network or timeout error.',\n      recommended_action: 'Wait, then retry the workflow up to the configured limit.'\n    };\n  }\n\n  if (/(429|rate limit|too many requests)/i.test(text)) {\n    return {\n      category: 'rate_limit',\n      retryable: true,\n      severity: 'medium',\n      diagnosis: 'Fallback rule detected a rate-limit error.',\n      recommended_action: 'Wait before retrying and reduce request frequency if needed.'\n    };\n  }\n\n  if (/(401|403|unauthorized|forbidden|authentication)/i.test(text)) {\n    return {\n      category: 'authentication',\n      retryable: false,\n      severity: 'high',\n      diagnosis: 'Fallback rule detected an authentication or authorization error.',\n      recommended_action: 'Review credentials or access permissions before retrying.'\n    };\n  }\n\n  return {\n    category: 'unknown',\n    retryable: false,\n    severity: 'medium',\n    diagnosis: 'Fallback could not safely classify the error.',\n    recommended_action: 'Review the incident manually; do not retry automatically.'\n  };\n}\n\nlet analysis;\nlet analysisSource;\n\nif (raw.trim()) {\n  const cleaned = raw\n    .replace(/^```json\\s*/i, '')\n    .replace(/\\s*```$/i, '')\n    .trim();\n\n  try {\n    analysis = JSON.parse(cleaned);\n    analysisSource = 'gemini';\n  } catch (error) {\n    analysis = getFallbackAnalysis();\n    analysisSource = 'fallback_invalid_gemini_response';\n  }\n} else {\n  analysis = getFallbackAnalysis();\n  analysisSource = 'fallback_gemini_unavailable';\n}\n\nreturn [\n  {\n    json: {\n      gemini: analysis,\n      analysisSource\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
