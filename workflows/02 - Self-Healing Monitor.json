      "id": "cb8acc5d-2ae1-40a5-b163-d1ec481c1358",
      "name": "Parse Gemini Analysis"
    },
    {
      "parameters": {
        "jsCode": "const gemini = $json.gemini ?? {};\nconst retryCount = Number($json.retryCount ?? 0);\n\nconst allowedCategories = [\n  'transient_network',\n  'rate_limit'\n];\n\nconst retryAllowed =\n  gemini.retryable === true &&\n  allowedCategories.includes(gemini.category) &&\n  retryCount < 2;\n\nconst route = retryAllowed ? 'retry' : 'notify';\n\nreturn [\n  {\n    json: {\n      ...$json,\n      retryCount,\n      retryAllowed,\n      route,\n      retryDelaySeconds: retryCount === 0 ? 30 : 60\n    }\n  }\n];\n"
      },
